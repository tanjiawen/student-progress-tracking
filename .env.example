# ============================================
# 学情跟踪系统 - 环境变量模板
# 复制为 .env 后修改，切勿将真实密码提交到版本控制
# ============================================

# 应用基础配置
# 生产环境必须设置 APP_ENV=production 且 DEBUG=false
APP_ENV=development
DEBUG=true
# SECRET_KEY 必须至少 32 字节长，生产环境请使用强随机字符串
SECRET_KEY=change-me-in-production-to-a-32-byte-random-string

# PostgreSQL 数据库
# 生产环境必须使用强密码（推荐 20+ 位混合大小写、数字、特殊字符）
POSTGRES_USER=student
POSTGRES_PASSWORD=change-me-in-production-use-strong-password
POSTGRES_DB=progress_tracking

# Redis 缓存与消息队列
# 支持密码认证格式: redis://:password@host:port/db
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# MinIO 对象存储
# 生产环境必须修改默认凭据，禁止使用 minioadmin/minioadmin
MINIO_ROOT_USER=change-me-in-production
MINIO_ROOT_PASSWORD=change-me-in-production-use-strong-password
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_NAME=student-progress
MINIO_SECURE=false

# Qdrant 向量数据库
QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=

# AI 服务 API Keys
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_GATEWAY_URL=http://deepseek-gateway:8787
# OPENAI_API_KEY=
# DASHSCOPE_API_KEY=
# MATHPIX_APP_ID=
# MATHPIX_API_KEY=

# Embedding 模型配置
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# 日志级别
LOG_LEVEL=INFO

# CORS 跨域配置（生产环境请设置为实际域名，多个用逗号分隔；留空表示禁止跨域）
# 例：ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 上传文件大小限制（MB）
MAX_UPLOAD_SIZE_MB=20

# 限流配置（每分钟请求数）
RATE_LIMIT_FREE=10
RATE_LIMIT_STANDARD=100
RATE_LIMIT_PREMIUM=1000
